# === OpenWeatherMap ===
# Crie uma conta grátis em https://openweathermap.org/api
# e gere uma chave API (Free tier: 60 chamadas/min, 1000/dia — suficiente)
OPENWEATHER_API_KEY=sua_chave_aqui

# === Localização ===
# Formato: "Cidade,Código do País" (ISO 3166)
CITY=São Paulo,BR

# === Twilio (SMS) ===
# Crie uma conta em https://www.twilio.com (trial gratuito inclui créditos)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=seu_auth_token_aqui

# Número Twilio que envia (formato E.164, ex: +14155552671)
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Seu número que recebe as mensagens (formato E.164, ex: +5511999999999)
TWILIO_TO_NUMBER=+55119XXXXXXXX

# === Horários e intervalos ===
# Hora do resumo diário (formato 24h, padrão: 7 = 07:00)
DAILY_SUMMARY_HOUR=7
DAILY_SUMMARY_MINUTE=0

# Intervalo em minutos para verificar chuva (padrão: 30)
RAIN_CHECK_INTERVAL_MINUTES=30
